# Generated by scripts/install.sh (chmod 600). Never commit configs/ops.env.
METJIRA_OPS_SECRET=change-me
# Password of the read-only PostgreSQL role met_jira_ops (SELECT on met_jira and met_jira_staging).
METJIRA_OPS_DB_PASSWORD=change-me
# MET AD accounts (sAMAccountName, comma separated) allowed into Ops. MET Jira system admins
# with an AD account and local MET Jira admins can always log in.
METJIRA_OPS_USERS=houcheng.fan
# Optional overrides — defaults match host 10.113.17.65 (prod :8800, staging :8810, pg :5434).
# LDAP settings are read from MET_Jira/configs/ldap.env, then MET_Jira-ops/configs/ldap.env,
# then this file:
# METJIRA_OPS_LDAP_ENV=/path/to/ldap.env
# METJIRA_OPS_LDAP_SHARED=/home/hal/docker/mira/MET_Jira/configs/ldap.env
# METJIRA_OPS_APP_ROOT=/home/hal/docker/mira/MET_Jira
# METJIRA_OPS_PUBLIC_HOST=10.113.17.65
# METJIRA_OPS_PROD_PORT=8800
# METJIRA_OPS_STAGING_PORT=8810
# METJIRA_OPS_PG_HOST=127.0.0.1
# METJIRA_OPS_PG_PORT=5434
# METJIRA_OPS_POSTGRES_UNIT=met-jira-postgres.service
# METJIRA_OPS_PROD_DSN=postgresql://met_jira_ops:...@127.0.0.1:5434/met_jira
# METJIRA_OPS_STAGING_DSN=postgresql://met_jira_ops:...@127.0.0.1:5434/met_jira_staging
# METJIRA_PGDATA=/data/docker/volumes/mira_mira-pg/_data
# METJIRA_LLM_BASE_URL=http://10.113.17.65:8001/v1
# METJIRA_OPS_ONLINE_TTL=120
