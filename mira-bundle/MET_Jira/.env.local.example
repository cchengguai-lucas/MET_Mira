# Mira 本地电脑快速启动配置模板（请复制为 .env 后再启动）

# === 数据库配置 ===
# 方案 A（推荐）：Docker 启动 PostgreSQL 16（支持 pg_trgm 智能查重与完整并发特性）
METJIRA_DATABASE_URL=postgresql+psycopg://met_jira:met_jira_dev@127.0.0.1:5433/met_jira
METJIRA_DB_PASSWORD=met_jira_dev

# 方案 B（零 Docker 备选）：SQLite 本地文件库
# 若电脑未安装 Docker，请注释掉上方两行，取消注释下面一行：
# METJIRA_DATABASE_URL=sqlite:///./data/mira_local.db

# === 应用与鉴权（本地独立运行，无需企业 AD） ===
METJIRA_SECRET=please-replace-with-a-32-char-random-local-secret-key
METJIRA_AUTH_MODE=local
METJIRA_ADMIN_USER=admin
METJIRA_ADMIN_PASSWORD=MetJira123!
METJIRA_SEED_SAMPLE_PROJECT=true
METJIRA_DATA_DIR=./data
METJIRA_COOKIE_SECURE=false
METJIRA_SCHEDULER=false
METJIRA_DEPLOY_ENV=development

# === LLM 大模型接口（OpenAI 兼容格式） ===
# 本地 Ollama 示例：http://127.0.0.1:11434/v1（免 API Key 开箱可用）
# 若暂不接大模型，可将 METJIRA_LLM_ENABLED 设为 false
METJIRA_LLM_ENABLED=true
METJIRA_LLM_BASE_URL=http://127.0.0.1:11434/v1
METJIRA_LLM_MODEL=qwen2.5:14b
METJIRA_LLM_TIMEOUT=90

# === 可选外部集成（本地演示可留空） ===
METJIRA_SOFTWARE_JIRA_URL=
METJIRA_SOFTWARE_JIRA_TOKEN=
METJIRA_ALERT_WEBHOOK_URL=
METJIRA_WECOM_PUSH_URL=
METJIRA_WECOM_PUSH_TOKEN=
METJIRA_SMTP_HOST=
METJIRA_SMTP_USER=
METJIRA_SMTP_PASSWORD=
