METJIRA_DATABASE_URL=postgresql+psycopg://met_jira:met_jira_dev@127.0.0.1:5433/met_jira
METJIRA_DB_PASSWORD=met_jira_dev
METJIRA_DB_POOL_SIZE=5
METJIRA_DB_MAX_OVERFLOW=5
METJIRA_DB_POOL_TIMEOUT=5
METJIRA_DB_POOL_RECYCLE=300
METJIRA_DB_POOL_USE_LIFO=true
METJIRA_DB_CONNECT_TIMEOUT=5
METJIRA_DB_APPLICATION_NAME=met-jira-production
# -1 disables psycopg server-side prepared statements (required for transaction pooling)
METJIRA_DB_PREPARE_THRESHOLD=-1
METJIRA_PROXY_TRUSTED_IPS=127.0.0.1
METJIRA_WEB_HOST=127.0.0.1
METJIRA_WEB_PORT=18801
METJIRA_WEB_WORKERS=2
METJIRA_SECRET=change-me-to-a-long-random-string
METJIRA_AUTH_MODE=auto
METJIRA_AD_ADMINS=
METJIRA_ADMIN_USER=admin
METJIRA_ADMIN_PASSWORD=MetJira123!
# Opt-in once-only sample project ELEC (default off; tests enable this)
METJIRA_SEED_SAMPLE_PROJECT=false
METJIRA_SESSION_HOURS=12
METJIRA_COOKIE_SECURE=false
METJIRA_LLM_ENABLED=true
METJIRA_LLM_BASE_URL=http://10.113.17.65:8001/v1
METJIRA_LLM_MODEL=DeepSeek V4 Flash
METJIRA_LLM_TIMEOUT=90
METJIRA_ORG_SYNC_HOUR=2
METJIRA_DUE_DIGEST_HOUR=8
METJIRA_REPORT_WEEKDAY=fri
METJIRA_SCHEDULER=true
METJIRA_OUTBOX_BATCH_SIZE=20
METJIRA_OUTBOX_LEASE_SECONDS=60
METJIRA_OUTBOX_POLL_SECONDS=2
METJIRA_ALERT_WEBHOOK_URL=
# WeCom bridge on 65 (token = TOOL_SHARED_SECRET of wecom-bridge)
METJIRA_WECOM_PUSH_URL=
METJIRA_WECOM_PUSH_TOKEN=
# Shared secret for machine callers of read-only external APIs (Bearer / X-Api-Key)
METJIRA_EXTERNAL_API_TOKEN=
# Software team's Jira relay. Empty leaves the snapshot disconnected.
# METJIRA_SOFTWARE_JIRA_URL=http://host:18787
# METJIRA_SOFTWARE_JIRA_TOKEN=
METJIRA_PUBLIC_URL=
# Reminder email (Aliyun enterprise mail, SSL)
METJIRA_SMTP_HOST=smtp.qiye.aliyun.com
METJIRA_SMTP_PORT=465
METJIRA_SMTP_USER=
METJIRA_SMTP_PASSWORD=
METJIRA_MAIL_FROM_NAME=Mira
# Staging only: deliver every alert to this address instead of real recipients
METJIRA_ALERT_REDIRECT=
