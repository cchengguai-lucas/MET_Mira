[databases]
@DATABASE@ = host=127.0.0.1 port=5433 dbname=@DATABASE@

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6433
unix_socket_dir = @RUNTIME_DIR@
pidfile = @RUNTIME_DIR@/pgbouncer.pid
logfile = @STATE_DIR@/pgbouncer.log

auth_type = scram-sha-256
auth_file = @USERLIST@
admin_users = @DB_USER@
stats_users = @DB_USER@

pool_mode = transaction
default_pool_size = 8
reserve_pool_size = 2
max_db_connections = 10
max_client_conn = 100
query_wait_timeout = 5

server_reset_query = DISCARD ALL
server_reset_query_always = 1
server_check_delay = 30
server_idle_timeout = 300
server_login_retry = 3
max_prepared_statements = 0

application_name_add_host = 1
log_connections = 1
log_disconnections = 1
log_pooler_errors = 1
