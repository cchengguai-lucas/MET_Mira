ENABLE_LDAP=true
LDAP_SERVER_LABEL=MET AD
LDAP_SERVER_HOST=10.113.17.2
LDAP_SERVER_PORT=389
LDAP_USE_TLS=false
LDAP_VALIDATE_CERT=false

# 服务账号：组织架构全量同步必须配置密码；登录时也会先用它搜索用户 DN。
LDAP_APP_DN=AI-Admin@met.com
LDAP_APP_PASSWORD=replace-with-service-account-password

LDAP_SEARCH_BASE=ou=met,dc=met,dc=com
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail
LDAP_ATTRIBUTE_FOR_NAME=displayName
LDAP_SEARCH_FILTERS=
LDAP_UPN_SUFFIX=met.com
LDAP_NETBIOS_DOMAIN=MET
