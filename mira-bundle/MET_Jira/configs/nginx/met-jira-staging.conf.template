worker_processes 1;
pid @RUNTIME_DIR@/nginx.pid;
error_log @STATE_DIR@/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    access_log @STATE_DIR@/nginx-access.log;
    client_body_temp_path @RUNTIME_DIR@/client_body;
    proxy_temp_path @RUNTIME_DIR@/proxy;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_static on;
    gzip_types
        application/javascript
        application/json
        application/xml
        image/svg+xml
        text/css
        text/plain;

    upstream met_jira_staging_api {
        server 127.0.0.1:18801;
        keepalive 16;
    }

    server {
        listen 0.0.0.0:8801;
        server_name _;
        client_max_body_size 50m;
        send_timeout 180s;

        location = /metrics {
            return 404;
        }

        location ^~ /metrics/ {
            return 404;
        }

        location ^~ /assets/ {
            root @ROOT@/web/dist;
            access_log off;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        # Every /api/agent endpoint can return SSE. Keep this prefix separate so
        # buffering and long-running timeouts cannot regress during refactors.
        location ^~ /api/agent/ {
            proxy_pass http://met_jira_staging_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;

            # This Nginx instance is the only trusted edge. Replace, rather than
            # append to, client-supplied forwarding headers.
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
        }

        location / {
            proxy_pass http://met_jira_staging_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
        }
    }
}
