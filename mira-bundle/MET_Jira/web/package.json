{
  "name": "met-jira-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "theme:check": "node scripts/check-mira-theme.mjs",
    "build": "npm run theme:check && tsc -b && vite build && npm run bundle:check && npm run assets:prune",
    "bundle:check": "node scripts/check-bundle.mjs",
    "assets:prune": "node scripts/prune-old-assets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tanstack/react-query": "^5.59.0",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.2.0",
    "echarts": "^5.6.0",
    "marked": "^15.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.5"
  }
}
