[Unit]
Description=MET Jira web (8800, production)
After=network.target met-jira-postgres.service
Wants=met-jira-postgres.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/configs/ldap.env
EnvironmentFile=-@ROOT@/.env
Environment=METJIRA_DATA_DIR=@ROOT@/data
Environment=METJIRA_DEPLOY_ENV=production
Environment=METJIRA_PRESENCE_ROOT=%h/.met_jira_ops/presence
ExecStart=/usr/bin/python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 8800 --proxy-headers
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
